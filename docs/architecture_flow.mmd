%% astrbot_task 架构流程图 (v1.3.5) — 重点: 发给大模型的请求组成
%% draw.io 导入: 菜单 + (插入) → 高级 → Mermaid → 粘贴本文件全部内容
flowchart TB
    subgraph CH["消息渠道"]
        QQ["QQ 官方机器人"]
        PHONE["手机 PWA selfchat :6188 令牌鉴权"]
        PANEL["WebUI 面板 :6187"]
    end

    QQ -->|"用户消息事件"| BUS["AstrBot 事件总线"]
    PHONE -->|"HTTP + 令牌"| SC["selfchat 适配器 · 历史落 selfchat_msg"]
    SC --> BUS
    BUS --> H1["插件 on_any_message · 情绪规则+好感 · 对话记录 · 轮次计数"]
    H1 -->|"满 20 轮"| SUM["后台周期总结 → facts 回灌长期记忆"]
    H1 --> REQ["LLM 请求组装 ★重点"]

    subgraph HERO["发给大模型的请求 —— 由以下部分组成"]
        direction TB
        subgraph FRAME["框架层(AstrBot 组装, 插件不改动)"]
            direction TB
            F1["① System Prompt · 人格(面板配置, 保 prompt 缓存)"]
            F2["② 对话历史(最近若干轮)"]
            F3["③ 工具定义(29 个 llm_tool + astr_kb_search)"]
            F4["④ 知识库检索段落(BM25+向量 → 可选 Rerank, 最多 5 块)"]
            F5["⑤ 用户当前消息"]
        end
        subgraph INJ["临时注入(on_llm_request · mark_as_temp: 不进历史 / 不破坏缓存)"]
            direction TB
            I1["⑥ 情绪上下文(规则+每轮微调+每10轮校准)"]
            I2["⑦ 相关记忆(两阶段召回 5 条, 45天半衰期)"]
            I3["⑧ 人格提醒(保持人格口吻, 不切助手腔)"]
            I4["⑨ 回复风格(至多三句 / 口语化 / 社媒习惯)"]
            I5["⑩ 当前时间(防日期幻觉)"]
        end
    end
    REQ --> HERO

    KB[("AstrBot 知识库 pota")]
    KB -.->|"检索片段"| F4
    T11["kb_write"] -->|"写入文档"| KB

    AGENT["LLM 工具循环(可多轮)"]
    HERO --> AGENT

    subgraph TOOLS["29 个工具"]
        direction LR
        T1["任务管理 ×8<br>含改期/撤销"]
        T2["记忆 ×2 · 时间 ×1"]
        T3["笔记 ×4<br>含 send_document 发文件"]
        T4["背诵抽查 ×3"]
        T5["web_search / open_url"]
        T6["search_papers<br>arXiv + OpenAlex"]
        T7["take_test 替做题"]
        T8["browser_task / browser_login<br>无头浏览器专用线程"]
        T9["calculate / weather"]
        T10["set_reminder / set_daily_content"]
    end
    AGENT --> TOOLS
    T8 -.->|"专用线程"| WB["无头 Chromium · 看页面→决策→执行 ≤25 步"]
    WB -.-> BST[("browser_state.json 登录态")]
    T8 -.->|"扫码/带登录态操作"| KB

    TOOLS --> RESP["LLM 响应"]
    RESP --> H2["插件 on_llm_response · 历史配对 + 后台任务"]
    H2 --> SPLIT["分段发送 · AstrBot 原生正则+随机间隔(插件分段已关)"]
    SPLIT --> OUT["双通道发送"]
    OUT --> QQ
    OUT --> SC

    SCHED["scheduler 每分钟 tick"] --> R["AI 定时提醒 / 临近开始 / 过期汇总 / 主动关心 / 每日内容推送 / 计划推送 / 凌晨备份"]
    R --> P1["push 双通道"]
    P1 --> QQ
    P1 --> SC

    subgraph DATA["数据层 data.db(插件数据目录, 更新免疫)"]
        DB[("tasks · memories · emotion · chats · notes · quiz_bank · selfchat_msg · 备份")]
    end
    H1 <-->|"写记录 / 读情绪状态"| DB
    T1 <-->|"任务增删改查"| DB
    T3 <-->|"笔记写读"| DB
    SC <-->|"历史读写"| DB
    SCHED <-->|"读写任务与日志"| DB
    DB -->|"记忆召回喂上下文"| I2
    PANEL -->|"展示查询"| DB

    classDef chan fill:#e8eef7,stroke:#5E82B5,stroke-width:2px
    classDef pipe fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef hero fill:#fce4ec,stroke:#c2185b,stroke-width:2px
    classDef frame fill:#fff3e0,stroke:#ef6c00,stroke-width:1.5px
    classDef inj fill:#f9e0ec,stroke:#c2185b,stroke-width:1.5px
    classDef tools fill:#fff8e1,stroke:#f9a825,stroke-width:1.5px
    classDef bg fill:#e3f2fd,stroke:#1565c0,stroke-width:1.5px
    classDef data fill:#f1f8e9,stroke:#558b2f,stroke-width:2px
    class QQ,PHONE,PANEL chan
    class BUS,REQ,AGENT,RESP,OUT pipe
    class HERO hero
    class F1,F2,F3,F4,F5 frame
    class I1,I2,I3,I4,I5 inj
    class T1,T2,T3,T4,T5,T6,T7,T8,T9,T10,T11,TOOLS,WB,BST tools
    class H1,H2,SUM,SPLIT,SC,SCHED,R,P1 bg
    class DB,KB,DATA data
